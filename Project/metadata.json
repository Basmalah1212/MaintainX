    "thermal_gradient_c", "heating_rate_c_min", "cooling_rate_c_min",
    "infrared_mean_temp_c", "infrared_max_temp_c", "thermal_hotspot_area_pct",
    "phase_transition_onset_c", "phase_transition_peak_c", "transition_enthalpy_j_g",
    "heat_dissipation_rate_w", "sensor_voltage_v", "sensor_current_ma",
